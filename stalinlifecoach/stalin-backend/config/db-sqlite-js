const sqlite3 = require('sqlite3').verbose();
const path = require('path');

const db = new sqlite3.Database(path.join(__dirname, '../therapy.db'));

// Create tables
db.serialize(() => {
  db.run(`CREATE TABLE IF NOT EXISTS appointments (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    bookingId TEXT UNIQUE,
    name TEXT,
    email TEXT,
    phone TEXT,
    date TEXT,
    time TEXT,
    message TEXT,
    paymentMethod TEXT,
    paymentStatus TEXT,
    paymentId TEXT,
    amount INTEGER,
    status TEXT,
    createdAt DATETIME DEFAULT CURRENT_TIMESTAMP
  )`);

  db.run(`CREATE TABLE IF NOT EXISTS payments (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    appointmentId INTEGER,
    amount INTEGER,
    method TEXT,
    transactionId TEXT,
    status TEXT,
    paymentData TEXT,
    createdAt DATETIME DEFAULT CURRENT_TIMESTAMP
  )`);
});

module.exports = db;